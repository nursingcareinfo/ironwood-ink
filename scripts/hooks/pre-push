#!/usr/bin/env bash
# Pre-push guard for this repo (see ~/.claude/skills/git-operations).
# Refuses pushes that would add/update .github/workflows/ — the auth token
# lacks the `workflow` scope, so such pushes are rejected by GitHub anyway.
set -euo pipefail

zero=$(git hash-object -t tree /dev/null)
while read -r _local_ref _local_sha _remote_ref _remote_sha; do
  if [ "$_local_sha" = "$zero" ]; then
    continue
  fi
  if git diff --name-only "$_remote_sha".."$_local_sha" 2>/dev/null | grep -q '^\.github/workflows/'; then
    echo "pre-push: refusing to push .github/workflows/ — token lacks 'workflow' scope." >&2
    echo "pre-push: use branch-based Pages instead (see skill://git-operations)." >&2
    exit 1
  fi
done

exit 0
